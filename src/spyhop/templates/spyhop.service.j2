# Generated by `spyhop service install`; regenerate instead of editing by hand.
[Unit]
Description=Spyhop: JIRA to Orca automation daemon
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
{% if env_source == "env_file" -%}
EnvironmentFile={{ env_file }}
ExecStart={{ exec_start }}
{%- else -%}
# Login shell: loads ~/.profile and, with it, the JIRA credentials
ExecStart={{ exec_start }}
{%- endif %}
Restart=always
RestartSec=30
Nice=10

[Install]
WantedBy=default.target
