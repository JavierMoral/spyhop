{#- Permission profile written to <worktree>/.claude/settings.local.json.
    Orca starts Claude with --dangerously-skip-permissions, so "allow" only
    matters if that changes; "deny" is enforced either way. -#}
{%- set allow = [] -%}
{%- for command in [
    "git status", "git diff", "git log", "git show", "git add", "git commit",
    "spyhop checkpoints check", "spyhop ticket", "spyhop declare"] -%}
{%- do allow.append("Bash(" ~ command ~ "*)") -%}
{%- endfor -%}
{%- for command in build_commands -%}
{%- do allow.append("Bash(" ~ command ~ "*)") -%}
{%- endfor -%}
{#- Pushing and opening a pull request are allowed for /pr, which CLAUDE-TASK.md
    reserves to the person; rewriting history on the remote, merging and
    closing are not. -#}
{%- set deny = [
    "Bash(git push --force*)", "Bash(git push -f*)", "Bash(git push --delete*)",
    "Bash(gh pr merge*)", "Bash(gh pr close*)", "Bash(git reset --hard*)",
    "Bash(git worktree remove*)", "Bash(wget*)"] -%}
{%- for orca in orca_commands -%}
{%- do allow.append("Bash(" ~ orca ~ " worktree set --worktree active*)") -%}
{%- do allow.append("Bash(" ~ orca ~ " jira issue*)") -%}
{%- do allow.append("Bash(" ~ orca ~ " jira comment list*)") -%}
{%- do deny.append("Bash(" ~ orca ~ " jira status*)") -%}
{%- do deny.append("Bash(" ~ orca ~ " jira comment add*)") -%}
{%- do deny.append("Bash(" ~ orca ~ " worktree rm*)") -%}
{%- endfor -%}
{#- The hooks record the state of the agent for the supervisor of Spyhop. -#}
{%- set hook = [{"type": "command", "command": spyhop ~ " hook"}] -%}
{%- set question = [{"matcher": "AskUserQuestion", "hooks": hook}] -%}
{%- set hooks = {
    "UserPromptSubmit": [{"hooks": hook}],
    "PreToolUse": question,
    "PostToolUse": question,
    "Notification": [{"hooks": hook}],
    "Stop": [{"hooks": hook}],
    "SessionEnd": [{"hooks": hook}]} -%}
{{ {"permissions": {"defaultMode": "acceptEdits", "allow": allow, "deny": deny}, "hooks": hooks}
    | tojson(indent=2) }}
